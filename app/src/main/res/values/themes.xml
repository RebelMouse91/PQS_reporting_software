         системной темы, и светлый фон окна давал бы вспышку при запуске. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorBackground">#0C0D11</item>
        <item name="android:statusBarColor">#0C0D11</item>
        <item name="android:navigationBarColor">#0C0D11</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
